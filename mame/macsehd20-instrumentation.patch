+void mac128_state::hd20_iwm_data_w(u8 data)
+{
+	if (m_hd20_command_length < sizeof(m_hd20_command))
+		m_hd20_command[m_hd20_command_length++] = data;
+	else
+	{
+		for (unsigned i = 1; i < sizeof(m_hd20_command); i++)
+			m_hd20_command[i - 1] = m_hd20_command[i];
+		m_hd20_command[sizeof(m_hd20_command) - 1] = data;
+	}
+
+	m_hd20_data_writes++;
+	logerror("[HD20-MAME] IWM data write %02x pc=%06x window=%u\n",
+		data, m_maincpu->pc(), m_hd20_command_length);
+
+	if (m_hd20_command_length == sizeof(m_hd20_command) &&
+		m_hd20_command[0] == 0xaa && m_hd20_command[1] == 0x00 &&
+		m_hd20_command[2] == 0x00 && m_hd20_command[3] == 0x00 &&
+		m_hd20_command[4] == 0x00 && m_hd20_command[5] == 0x00 &&
+		m_hd20_command[6] == 0xfc && m_hd20_command[7] == 0x00)
+	{
+		logerror("[HD20-MAME] captured native block-0 command pc=%06x\n", m_maincpu->pc());
+		u8 logical[539]{};
+		logical[0] = 0x80;
+		logical[1] = 0x00;
+		for (unsigned i = 0; i < 538; i++)
+			logical[538] = u8(logical[538] + logical[i]);
+		logical[538] = u8(0 - logical[538]);
+		m_hd20_response[0] = 0xaa;
+		m_hd20_response[1] = 0xaa;
+		unsigned out = 2;
+		for (unsigned i = 0; i < sizeof(logical); i += 7)
+		{
+			u8 low = 0;
+			for (unsigned j = 0; j < 7 && i + j < sizeof(logical); j++)
+			{
+				m_hd20_response[out++] = u8(0x80 | (logical[i + j] >> 1));
+				low |= u8((logical[i + j] & 1) << j);
+			}
+			m_hd20_response[out++] = u8(0x80 | low);
+		}
+		m_hd20_response[out++] = 0x00;
+		m_hd20_response_length = out;
+		m_hd20_response_index = 0;
+		logerror("[HD20-MAME] synthetic response queued length=%u checksum=%02x\n",
+			m_hd20_response_length, logical[538]);
+		m_hd20_command_length = 0;
+	}
+}
+
+void mac128_state::hd20_iwm_data_observe(offs_t offset, u8 data)
+{
+	m_hd20_data_reads++;
+	logerror("[HD20-MAME] IWM data read %02x pc=%06x count=%u\n",
+		data, m_maincpu->pc(), m_hd20_data_reads);
+}
+
+u8 mac128_state::hd20_iwm_data_valid(offs_t offset)
+{
+	return m_hd20_response_index < m_hd20_response_length;
+}
+
+u8 mac128_state::hd20_iwm_data_override(offs_t offset)
+{
+	if (m_hd20_response_index >= m_hd20_response_length)
+		return 0xff;
+	const u8 value = m_hd20_response[m_hd20_response_index++];
+	if (m_hd20_response_index == m_hd20_response_length)
+		logerror("[HD20-MAME] response FIFO exhausted pc=%06x\n", m_maincpu->pc());
+	return value;
+}
